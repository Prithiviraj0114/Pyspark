
from pyspark.sql import SparkSession
from pyspark.sql.types import StringType

# Step 1: Create Spark Session
spark = SparkSession.builder \
    .master("local[*]") \
    .appName("Count Non String Columns") \
    .config("spark.driver.host", "127.0.0.1") \
    .config("spark.driver.bindAddress", "127.0.0.1") \
    .getOrCreate()

# Step 2: Create DataFrame using Spark SQL
df = spark.sql("""
    SELECT * FROM VALUES
    (1, 'Abinash', 25, 45000.50),
    (2, 'Arun', 22, 35000.00),
    (3, 'Kumar', 24, 40000.00)
    AS data(ID, Name, Age, Salary)
""")

# Step 3: Display DataFrame
df.show()

# Step 4: Display Schema
df.printSchema()

# Step 5: Count Non-String Columns
count = sum(
    1 for field in df.schema.fields
    if not isinstance(field.dataType, StringType)
)

# Step 6: Print Result
print("Number of columns that are not strings:", count)

# Step 7: Stop Spark Session
spark.stop()
