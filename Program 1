
# Step 1: Configure Python Worker
import os
import sys

os.environ["PYSPARK_PYTHON"] = sys.executable
os.environ["PYSPARK_DRIVER_PYTHON"] = sys.executable
os.environ["SPARK_LOCAL_IP"] = "127.0.0.1"

# Step 2: Import Libraries
from pyspark.sql import SparkSession
from pyspark.sql.types import StringType

# Step 3: Create Spark Session
spark = SparkSession.builder \
    .master("local[2]") \
    .appName("Count Non String Columns") \
    .config("spark.driver.host", "127.0.0.1") \
    .config("spark.driver.bindAddress", "127.0.0.1") \
    .getOrCreate()

# Step 4: Create Sample Data
data = [
    (1, "Abinash", 25, 45000.50),
    (2, "Arun", 22, 35000.00),
    (3, "Kumar", 24, 40000.00)
]

columns = ["ID", "Name", "Age", "Salary"]

# Step 5: Create DataFrame
df = spark.createDataFrame(data, columns)

# Step 6: Display DataFrame
df.show()

# Step 7: Display Schema
df.printSchema()

# Step 8: Count Non-String Columns
count = sum(
    1 for field in df.schema.fields
    if not isinstance(field.dataType, StringType)
)

# Step 9: Print Result
print("Number of columns that are not strings:", count)

# Step 10: Stop Spark
spark.stop()
